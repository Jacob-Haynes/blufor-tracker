# /etc/blufor-tracker.env — read by mesh-bridge.service and deploy/install.sh.
# install.sh creates this file (mode 600) on first run; edit and re-run install to apply hotspot changes.

# Meshtastic bridge radio: "auto" probes /dev/serial/by-id, /dev/ttyUSB*, /dev/ttyACM*
MESH_PORT=auto

# Local broker (OpenTAKServer's RabbitMQ MQTT plugin) — also carries meshbus/tx, meshbus/rx and
# isrkit/heartbeat/*. The bridge runs on the Pi, so guest (loopback-only) is right here.
MQTT_HOST=127.0.0.1
MQTT_PORT=1883
MQTT_USER=guest
MQTT_PASS=guest

# WiFi hotspot for ATAK phones. Leave HOTSPOT_PASS empty and install.sh generates one
# and writes it back here. WPA2 needs 8-63 characters.
HOTSPOT_SSID=BFT-TAK
HOTSPOT_PASS=

# Heartbeat on isrkit/heartbeat/blufor-tracker every 10 s (HEARTBEAT=0 disables).
# PUBLIC_URL overrides the advertised URL (default http://<hostname>.local/, the OTS web UI).
HEARTBEAT=1
# ISR_HOST names this station in the heartbeat (default: lowercased short hostname), e.g. isr-pi
ISR_HOST=

# Shared OP position (kit contract C4.2), the same in every tool's env file. Only --simulate uses it
# here: the fake BFT units move around it (default Salisbury Plain 51.15,-1.75; never 0,0).
SENSOR_LAT=
SENSOR_LON=

# Step-by-step demo (ui-kit DEMO-TRIGGER-CONTRACT.md). continuous (default): as before.
# on_demand: no background simulation; the presenter fires the "patrol" scenario from the Demo page.
DEMO_MODE=continuous
# Demo page and API (dual-stack). 0 turns it off.
DEMO_PORT=8170

# Channel URL (contains the channel PSK) for the launcher's PIN-gated onboarding QR.
# Written on radio connect and re-checked every 60 s; mode 0640, group isr-launcher. Empty disables.
CHANNEL_URL_FILE=/var/lib/blufor-tracker/channel-url
