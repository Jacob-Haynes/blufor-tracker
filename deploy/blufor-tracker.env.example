# /etc/blufor-tracker.env — read by mesh-bridge.service and deploy/install.sh.
# install.sh creates this file (mode 600) on first run; edit and re-run install to apply hotspot changes.

# Meshtastic bridge radio: "auto" probes /dev/serial/by-id, /dev/ttyUSB*, /dev/ttyACM*
MESH_PORT=auto

# Local broker (OpenTAKServer's RabbitMQ MQTT plugin) — also carries meshbus/tx and meshbus/rx
MQTT_HOST=127.0.0.1
MQTT_PORT=1883
MQTT_USER=guest
MQTT_PASS=guest

# WiFi hotspot for ATAK phones. Leave HOTSPOT_PASS empty and install.sh generates one
# and writes it back here. WPA2 needs 8-63 characters.
HOTSPOT_SSID=BFT-TAK
HOTSPOT_PASS=
